<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Faza 0 - szkielet. Czysta aplikacja WPF startujaca do traya, bez audio.
    TargetFramework: net8.0-windows (LTS, szeroko zainstalowany). Jesli masz
    nowszy stabilny SDK (np. net10.0-windows) wystarczy zmienic te jedna linie.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- WPF na okno ustawien, WinForms tylko dla ikony w trayu (NotifyIcon). -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>Equalizer</AssemblyName>
    <RootNamespace>Equalizer</RootNamespace>
  </PropertyGroup>

  <!--
    Konfiguracja pod pojedynczy plik .exe (self-contained, dwuklik i dziala).
    Build do dystrybucji:
      dotnet publish -c Release -r win-x64
    Zwykly build deweloperski wystarczy:
      dotnet build
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
